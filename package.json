{
  "name": "nur-lingo",
  "version": "1.0.0",
  "description": "AI-native Armenian ↔ English language learning platform with semantic NLP engine",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:clean": "rimraf .next && next dev -p 3002",
    "build": "next build",
    "build:clean": "rimraf .next && next build",
    "start": "next start -p 3002",
    "start:3000": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:migrate": "supabase db push",
    "db:seed": "tsx scripts/seed-lexicon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:user": "node scripts/migrate-user-dictionary.js",
    "audit": "tsx scripts/system-audit.ts",
    "audit:watch": "nodemon --exec 'npm run audit' --watch src --ext ts,tsx",
    "audit:quick": "tsx scripts/system-audit.ts --quick",
    "health": "tsx scripts/health-check.ts",
    "test:all": "npm run type-check && npm run lint && npm run audit:quick",
    "pre-commit": "npm run test:all",
    "fix": "tsx scripts/auto-fix.ts",
    "fix:watch": "nodemon --exec 'npm run fix' --watch src --ext ts,tsx",
    "audit:fix": "npm run audit && npm run fix && npm run audit",
    "setup": "npm install && npm run fix && npm run build",
    "fix:remaining": "tsx scripts/fix-remaining-errors.ts",
    "fix:final": "tsx scripts/fix-final-errors.ts",
    "fix:badge": "tsx scripts/fix-badge-final.ts",
    "fix:all": "tsx scripts/fix-all-i18n.ts",
    "fix:final-all": "tsx scripts/fix-final-all.ts",
    "fix:last": "tsx scripts/fix-last-errors.ts",
    "fix:dialogue": "tsx scripts/fix-dialogue-final.ts",
    "fix:dialogue-simple": "tsx scripts/fix-dialogue-simple.ts",
    "fix:all-remaining": "tsx scripts/fix-all-remaining.ts",
    "test:lessons": "tsx scripts/test-lesson-system.ts",
    "test:lessons:watch": "tsx watch scripts/test-lesson-system.ts",
    "check-build": "tsx scripts/check-build-errors.ts",
    "check-types": "tsc --noEmit",
    "build:check": "npm run check-types && npm run build",
    "find-errors": "tsx scripts/find-all-build-errors.ts",
    "find-errors:fast": "tsx scripts/find-all-build-errors.ts 2>&1 | head -100",
    "sync-audio": "tsx scripts/sync-audio.ts",
    "sync-audio:check": "tsx scripts/sync-audio.ts --check-only",
    "sync-audio:fix": "tsx scripts/sync-audio.ts --fix-missing",
    "sync-audio:clean": "tsx scripts/sync-audio.ts --clean-orphans",
    "generate-audio-mapping": "ts-node scripts/generate-audio-mapping.ts",
    "test:audio": "node scripts/test-audio-system.js",
    "test:offline": "node scripts/test-offline-audio.js",
    "fix:audio": "python fix_audio_system.py",
    "scan:audio": "python nur_audio_mapping_scanner.py",
    "rebuild:manifests": "python rebuild_audio_manifests.py",
    "check:audio": "node scripts/check-audio-health.js",
    "analyze-texts": "tsx scripts/analyze-hardcoded-texts.ts",
    "check:i18n": "tsx scripts/check-i18n-full.ts",
    "check:i18n:fix": "tsx scripts/check-i18n.ts --fix",
    "fix:i18n": "tsx scripts/fix-i18n-imports.ts",
    "fix:usei18n": "tsx scripts/fix-missing-usei18n.ts",
    "emergency": "tsx scripts/emergency-fix.ts",
    "scan": "tsx scripts/scan-all-bugs.ts",
    "check:usei18n": "tsx scripts/check-usei18n.ts",
    "bugs": "tsx scripts/analyze-runtime-bugs.ts",
    "find-switcher": "tsx scripts/find-language-switcher.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/ssr": "^0.4.0",
    "@supabase/supabase-js": "^2.43.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.0.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.23.0",
    "next": "^14.2.0",
    "openai": "^4.40.0",
    "react": "^18.3.0",
    "react-day-picker": "^8.10.2",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10",
    "edge-tts": "^1.0.1",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "glob": "^13.0.6",
    "nodemon": "^3.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^1.0.0"
  }
}
